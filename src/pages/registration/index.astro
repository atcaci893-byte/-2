---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InfoTable from '../../components/InfoTable.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { faqSchema } from '../../lib/schema';

const faq = [
  { question: 'Чи можна зареєструватися в Pokerbet з телефону?', answer: 'Так. Pokerbet підтримує мобільний доступ, а створення акаунту можна розпочати зі смартфона. На мобільному екрані елементи форми можуть розташовуватися інакше, але мова йде про той самий акаунт.' },
  { question: 'Чи потрібен промокод для реєстрації Pokerbet?', answer: 'Ні, промокод не слід вважати обов’язковою умовою самого створення акаунту. Якщо у формі є відповідне поле, код використовується для конкретної акції та має відповідати її умовам.' },
  { question: 'Що робити, якщо не приходить код підтвердження Pokerbet?', answer: 'Перевірте номер телефону або email, папку "Спам" та повторно запросіть код, якщо форма це дозволяє. Якщо повідомлення так і не надходить, зверніться до підтримки.' },
  { question: 'Чи потрібен KYC одразу після реєстрації?', answer: 'Pokerbet реєстрація та KYC - різні етапи. Платформа вказує, що верифікація потрібна перед виведенням коштів; тому не слід писати, що кожен новий акаунт обов’язково проходить повну документальну перевірку відразу після створення.' },
  { question: 'Що робити, якщо платформа не дає створити акаунт Pokerbet?', answer: 'Перевірте поля форми, контактні дані та повідомлення про помилку. Якщо проблема не зникає, зверніться до підтримки з описом ситуації. Створювати другий профіль із чужими або вигаданими даними не варто.' },
  { question: 'Чи можна після реєстрації одразу поповнити рахунок?', answer: 'Фінансові операції доступні через касу, але перед першим депозитом краще перевірити статус акаунту, валюту рахунку та умови конкретної бонусної пропозиції.' },
];
const infoRows = [
  ['Спосіб створення профілю', 'Через форму реєстрації Pokerbet'],
  ['Контакти', 'Мобільний номер та актуальна email-адреса'],
  ['Особисті дані', 'Ім’я, прізвище, дата народження'],
  ['Логін', 'Потрібно обрати під час створення акаунту'],
  ['Пароль', 'Створюється під час реєстрації'],
  ['Адреса', 'Вказується як частина обов’язкової інформації акаунту'],
  ['Валюта', 'Базова валюта рахунку обирається під час реєстрації'],
  ['Підтвердження контакту', 'Pokerbet передбачає підтвердження email або телефону'],
  ['KYC', 'Окрема процедура; деталі належать до сторінки верифікації'],
];
const fieldsRows = [
  ['Ім’я', 'Реальне ім’я', 'Має відповідати даним для подальшої перевірки'],
  ['Прізвище', 'Реальне прізвище', 'Не варто використовувати скорочення'],
  ['Дата народження', 'Реальна дата', 'Може використовуватися під час перевірки віку'],
  ['Email', 'Чинна адреса пошти', 'Потрібна для зв’язку та відновлення доступу'],
  ['Телефон', 'Актуальний номер', 'Використовується для контакту та підтвердження'],
  ['Логін', 'Вигадане ім’я користувача', 'Не повинен містити персональні дані'],
  ['Пароль', 'Унікальна комбінація', 'Використовуйте окремий пароль'],
  ['Валюта', 'Підтримувана валюта рахунку', 'Базова валюта обирається під час реєстрації'],
];
const errorRows = [
  ['Не приймається email', 'Правильність адреси', 'Перевірити символи й спробувати ще раз'],
  ['Не підтверджується телефон', 'Номер та формат введення', 'Перевірити номер і повторно запросити код підтвердження Pokerbet'],
  ['Код не приходить', 'Пошта, SMS, правильність контакту', 'Перевірити "Спам" і повторити запит'],
  ['Дані не приймаються', 'Заповнення обов’язкових полів', 'Перевірити форму зверху вниз'],
  ['Профіль уже існує', 'Контакт уже пов’язаний із профілем', 'Не створювати другий акаунт, а відновити доступ'],
];
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Реєстрація', href: '/registration/' }];
---

<BaseLayout title="Реєстрація Pokerbet 2026: як створити акаунт" description="Реєстрація Pokerbet 2026: як створити акаунт, які дані потрібні, як підтвердити телефон або email та що робити, якщо форма реєстрації не приймає дані." breadcrumbs={crumbs} schemas={[faqSchema(faq)]}>
  <Hero eyebrow="Реєстрація" title="Реєстрація Pokerbet 2026: як зареєструватися та створити акаунт" description="Щоб створити акаунт Pokerbet, користувачу достатньо відкрити сторінку реєстрації, заповнити форму своїми даними, погодитися з правилами та завершити підтвердження контактів, якщо система його запитує." secondaryLabel="Навіщо потрібна KYC" secondaryHref="/verification/" />

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Основна інформація</p><h2>Pokerbet реєстрація 2026</h2></div>
    <p>Для відкриття рахунку користувач має надати достовірні персональні та контактні дані, а також обрати ім’я користувача і пароль. На практиці порядок виглядає так: відкрити Pokerbet, натиснути "Реєстрація", заповнити форму, створити логін і пароль, підтвердити контакт та увійти в акаунт.</p>
    <InfoTable caption="Основна інформація про реєстрацію Pokerbet" headers={['Параметр', 'Що вдалося підтвердити']} rows={infoRows} />
    <p>Важливо не змішувати реєстрацію з KYC. Створення профілю - це заповнення анкети та відкриття рахунку. Верифікація - окрема перевірка даних і документів, яка може знадобитися пізніше.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Порядок дій</p><h2>Як зареєструватися на Pokerbet</h2></div>
    <ol class="steps">
      <li><strong>Відкрити форму реєстрації</strong><p>Перед заповненням анкети перевірте адресу сторінки, особливо якщо ви прийшли з пошукової видачі або зовнішнього посилання.</p></li>
      <li><strong>Заповнити реєстраційні дані</strong><p>Вносіть власні дані без скорочень і вигаданих значень. Pokerbet вимагає достовірну та актуальну інформацію.</p></li>
      <li><strong>Придумати логін і пароль</strong><p>Логін не повинен містити ім’я, прізвище чи іншу персональну інформацію. Пароль краще зробити окремим для Pokerbet.</p></li>
      <li><strong>Вибрати валюту рахунку</strong><p>Базова валюта визначається на етапі створення профілю, тому поле варто перевірити перед підтвердженням форми.</p></li>
      <li><strong>Підтвердити акаунт</strong><p>Після заповнення форми може знадобитися підтвердження email через лист або номера телефону за допомогою SMS-коду.</p></li>
    </ol>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Дані</p><h2>Які дані потрібні для реєстрації Pokerbet</h2></div>
    <p>Нижче - тільки ті відомості, які вдалося підтвердити в актуальних правилах Pokerbet та матеріалах самого бренду. Там, де конкретний формат поля залежить від інтерфейсу, не варто вигадувати його назву.</p>
    <InfoTable caption="Дані для реєстрації Pokerbet" headers={['Поле', 'Що вводити', 'Особливості']} rows={fieldsRows} />
    <p>Особливу увагу потрібно приділити імені, прізвищу та даті народження. Неправдива або оманлива інформація може стати підставою для блокування або закриття ігрового профілю.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Телефон</p><h2>Покербет реєстрація з телефону</h2></div>
    <p>Зі смартфона процес починається так само: відкрити Pokerbet, натиснути "Реєстрація" та заповнити форму. У мобільній версії частина елементів може розміщуватися інакше через менший екран, однак базові дані ігрового профілю залишаються тими самими.</p>
    <p>Pokerbet реєстрація з телефону не означає окремий тип профілю. Це той самий користувацький профіль, до якого можна входити з різних підтримуваних пристроїв.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Промокод</p><h2>Промокод і бонус за реєстрацію від Покербет</h2></div>
    <p>Під час реєстрації Покербет може відображатися окреме поле для введення промокоду. Якщо воно присутнє у вашій версії форми, його потрібно заповнити до завершення реєстрації. Сам код не є обов’язковою частиною створення акаунту, якщо форма дозволяє перейти далі без нього.</p>
    <p>Сам факт реєстрації не варто трактувати як автоматичне отримання будь-якого бонусу. Право на конкретну винагороду визначається умовами відповідної акції.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Помилки</p><h2>Чому не вдається створити акаунт Pokerbet</h2></div>
    <p>Причину варто шукати в конкретному повідомленні форми, а не просто раз за разом повторювати реєстрацію.</p>
    <InfoTable caption="Типові проблеми з реєстрацією Pokerbet" headers={['Помилка', 'Що перевірити', 'Що робити']} rows={errorRows} />
    <p>Не варто створювати другий профіль на інший номер або чужі дані, щоб обійти помилку реєстрації. Якщо проблема залишається, краще звернутися до підтримки і вказати точний текст помилки.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Після форми</p><h2>Що робити після реєстрації</h2></div>
    <ul>
      <li>увійти в новий акаунт Pokerbet і перевірити, чи збереглися дані;</li>
      <li>переконатися, що телефон або email підтверджені;</li>
      <li>перевірити статус доступних бонусів, якщо вони вас цікавлять;</li>
      <li>після цього перейти до каси та вивчити доступні способи поповнення.</li>
    </ul>
  </section>

  <FAQ items={faq} />
  <CTA title="Після створення акаунта" text="Перевірте вимоги до верифікації та документи, які можуть знадобитися." label="Перейти до KYC-гіда" href="/verification/" />
</BaseLayout>
