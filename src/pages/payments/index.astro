---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InfoTable from '../../components/InfoTable.astro';
import FAQ from '../../components/FAQ.astro';
import PaymentStrip from '../../components/PaymentStrip.astro';
import { paymentMethods, paymentCurrency } from '../../data/payments';
import { faqSchema } from '../../lib/schema';

const faq = [
  { question: 'Який мінімальний депозит у Pokerbet?', answer: 'Однієї суми для всіх методів немає. Мінімум залежить від обраного платіжного способу та показується в його умовах або касі.' },
  { question: 'Які способи оплати підтримує Pokerbet?', answer: 'Це банківські картки, Skrill, NETELLER, криптовалюти та інші платіжні методи поповнення Pokerbet. Актуальний перелік потрібно перевіряти безпосередньо в касі, оскільки він може змінюватися.' },
  { question: 'Скільки триває виведення грошей із Pokerbet?', answer: 'Заявки на withdrawal обробляються 24/7, але універсальний строк зарахування для всіх методів правила не встановлюють. Після обробки Pokerbet додатковий час може знадобитися банку або платіжному сервісу.' },
  { question: 'Чи потрібна верифікація для виведення?', answer: 'Так, перевірка власника акаунта та платіжного рахунку може бути необхідною. Для окремих сум і випадків додаткової ідентифікації Pokerbet прямо передбачає запит документів.' },
  { question: 'Чи є комісія за виведення?', answer: 'Витрати на переказ можуть утримуватися із суми виплати Pokerbet, а платіжний сервіс може застосувати власну комісію. Крім того, для акаунтів із недостатнім оборотом Pokerbet передбачає окрему плату за обробку withdrawal.' },
  { question: 'Що робити, якщо гроші списали, але не прийшли?', answer: 'Перевірте статус заявки та історію транзакцій і не оформлюйте повторний withdrawal одразу. Якщо операція вже оброблена Pokerbet, але кошти не надійшли, перевірте платіжний сервіс або зверніться до підтримки Pokerbet із номером транзакції.' },
];
const summaryRows = [
  ['Валюта рахунку', paymentCurrency],
  ['Основний розділ', 'Каса'],
  ['Поповнення Pokerbet', 'Банківські картки, електронні гаманці, окремі криптовалютні методи'],
  ['Виведення Pokerbet', 'Окремий список методів, який може відрізнятися від депозитного'],
  ['Мінімальний депозит', 'Залежить від способу'],
  ['Мінімальне виведення', 'Залежить від способу'],
  ['KYC', 'Може бути необхідним перед виведенням'],
  ['Заявка на виведення', 'Через сайт Pokerbet'],
];
const depositRows = [
  ['Visa / Mastercard', 'У карткових інструкціях Pokerbet - протягом кількох секунд', 'Потрібні реквізити картки'],
  ['NETELLER', 'У платіжній інструкції - протягом кількох секунд', 'Потрібен власний акаунт NETELLER'],
  ['Skrill', 'У платіжній інструкції - протягом кількох секунд', 'Потрібен власний акаунт Skrill'],
  ['Криптовалюта', 'Залежить від підтвердження транзакції', 'Потрібно використовувати саме зазначену мережу'],
  ['Платіжні термінали / локальні методи', 'Залежить від способу', 'Доступність потрібно дивитися в касі'],
];
const withdrawalRows = [
  ['Visa / Mastercard', 'Так', 'Перевіряється в актуальних умовах', 'Виведення - на ту саму картку, з якої робився депозит Pokerbet'],
  ['Skrill', 'Так', 'Може стягуватися провайдером', 'Потрібен власний гаманець'],
  ['NETELLER', 'Так', 'Може стягуватися провайдером', 'Потрібен власний гаманець'],
  ['Криптовалюта', 'Так', 'Можливі витрати платіжної мережі', 'Потрібно використовувати правильну адресу та мережу'],
];
const problemRows = [
  ['Заявка не обробляється', 'Потрібна додаткова перевірка', 'Перевірити повідомлення акаунта та статус KYC'],
  ['Зняття відхилено', 'Порушення вимог до платіжного методу або даних', 'Перевірити власника рахунку та умови методу'],
  ['Попросили документи', 'Додаткова ідентифікація', 'Подати документи через передбачений оператором канал'],
  ['Гроші списані з балансу, але не отримані', 'Платіж ще обробляється системою', 'Перевірити статус заявки та не створювати дубль'],
  ['Сума виплати менша за очікувану', 'Комісія Pokerbet або обмеження методу', 'Переглянути розрахунок і умови конкретного способу'],
  ['Картку для виведення не можна вибрати', 'Не відповідає попередньому депозиту', 'Перевірити історію платежів Pokerbet'],
];
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Платежі', href: '/payments/' }];
---

<BaseLayout title="Pokerbet поповнення та виведення 2026: методи й ліміти" description="Поповнення та виведення Pokerbet: як внести кошти й оформити виплату, які методи, ліміти, комісії та строки діють і коли може знадобитися верифікація." breadcrumbs={crumbs} schemas={[faqSchema(faq)]}>
  <Hero eyebrow="Платежі" title="Поповнення та виведення Pokerbet 2026: методи, ліміти та строки" description="Pokerbet поповнення рахунку проводиться через розділ «Каса» після входу в акаунт. Мінімальна сума та доступність методів залежать від конкретного способу оплати." secondaryLabel="Перевірити KYC" secondaryHref="/verification/" />
  <PaymentStrip />

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Основна інформація</p><h2>Pokerbet поповнення та виведення у 2026 році</h2></div>
    <p>Pokerbet підтримує гривню, долар та євро і не встановлює один універсальний мінімум для всіх способів оплати. У правилах платформи прямо зазначено, що мінімальна сума депозиту та подальшого виведення залежить від вибраного платіжного методу.</p>
    <InfoTable caption="Основна інформація про платежі Pokerbet" headers={['Параметр', 'Деталі']} rows={summaryRows} />
    <p>У правилах також встановлено загальний ліміт на зняття виграшів: не більше 10 000 євро протягом тижня та 25 000 євро протягом місяця. Це правила для Pokerbet виведення, а не універсальний ліміт окремого платіжного методу.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Поповнення</p><h2>Як поповнити рахунок Pokerbet</h2></div>
    <ol class="steps">
      <li><strong>Увійдіть до акаунта Pokerbet.</strong><p>Відкрийте розділ "Каса".</p></li>
      <li><strong>Перейдіть до вкладки "Поповнити".</strong><p>Виберіть потрібний платіжний метод.</p></li>
      <li><strong>Вкажіть суму поповнення.</strong><p>Заповніть платіжні дані або перейдіть на сторінку платіжного сервісу.</p></li>
      <li><strong>Підтвердьте операцію.</strong><p>Після цього перевірте баланс і статус транзакції.</p></li>
    </ol>
    <p>Якщо в акаунті активний бонус, перед депозитом також варто перевірити його умови. У деяких акціях спосіб оплати або порядок внесення коштів впливає на участь у пропозиції.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Методи</p><h2>Способи поповнення Pokerbet</h2></div>
    <p>Набір методів потрібно оцінювати саме за касою, оскільки публічні сторінки можуть містити ширший перелік. На сайті Pokerbet описані картки Visa/Mastercard, Skrill, NETELLER, криптовалютні платежі та окремі локальні методи.</p>
    <InfoTable caption="Способи поповнення Pokerbet" headers={['Метод', 'Час зарахування', 'Особливості']} rows={depositRows} />
    <InfoTable caption="Платіжні методи та умови" headers={['Метод', 'Мін. депозит', 'Мін. виведення', 'Комісія', 'Час']} rows={paymentMethods.map((item) => [item.method, item.minDeposit, item.minWithdrawal, item.fee, item.time])} />
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Деталі депозиту</p><h2>Картка, електронні гаманці та криптовалюта</h2></div>
    <div class="card-grid">
      <article class="info-card"><span class="number">CARD</span><h3>Банківська картка</h3><p>Після вибору Visa або Mastercard вказується сума, вводяться реквізити картки та підтверджується платіж. Використовувати потрібно власну картку.</p></article>
      <article class="info-card"><span class="number">WAL</span><h3>Skrill та NETELLER</h3><p>Після вибору сервісу в касі користувач вводить суму, авторизується у власному гаманці та підтверджує оплату.</p></article>
      <article class="info-card"><span class="number">CRY</span><h3>Криптовалюта</h3><p>Важливо вибрати ту монету та мережу, які показує каса. Адресу потрібно копіювати з актуальної платіжної форми.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Виведення</p><h2>Як вивести гроші з Pokerbet</h2></div>
    <p>Заявка на Покербет виведення коштів оформлюється через розділ "Каса". Запит на виплату приймається через сайт; заявки телефоном або електронною поштою не обробляються.</p>
    <ol class="steps">
      <li><strong>Увійти до акаунта Pokerbet.</strong><p>Відкрити "Касу" та перейти до розділу виведення.</p></li>
      <li><strong>Вибрати доступний платіжний метод.</strong><p>Для різних методів поля відрізняються.</p></li>
      <li><strong>Вказати суму та реквізити.</strong><p>Для картки потрібен номер картки, для гаманця - дані сервісу, для криптовалюти - адреса.</p></li>
      <li><strong>Підтвердити заявку.</strong><p>Після відправлення її обробляє оператор.</p></li>
    </ol>
    <p>Час внутрішньої обробки та час, за який кошти фактично надходять на картку або гаманець, - різні показники. Pokerbet зазначає, що заявки обробляються цілодобово, але не встановлює одну універсальну кількість годин для всіх способів.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Виплати</p><h2>Способи виведення коштів Pokerbet</h2></div>
    <p>Наявність конкретного методу потрібно перевіряти в касі в момент подання заявки. Сам факт, що спосіб використовується для депозиту, не означає автоматичного доступу до нього для зняття виграшу.</p>
    <InfoTable caption="Способи виведення Pokerbet" headers={['Спосіб', 'Доступно для виведення', 'Комісія Pokerbet', 'Що потрібно врахувати']} rows={withdrawalRows} />
    <p>Для карткових транзакцій діє окреме правило: Visa або Mastercard повинна бути тією самою карткою, яка використовувалася для депозиту. Переказ на чужу картку заборонений.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Ліміти</p><h2>Мінімальний депозит Pokerbet та поточні ліміти на зняття</h2></div>
    <p>У Pokerbet немає єдиного універсального мінімуму, який можна застосувати до всіх платіжних методів. Те саме стосується депозиту: мінімальна сума може відрізнятися залежно від платіжного каналу.</p>
    <p>Водночас правила встановлюють загальний ліміт виведення - не більше 10 000 євро протягом тижня і 25 000 євро протягом місяця. Якщо сума виграшу становить 20 000 євро або більше, Pokerbet залишає за собою право розбити виплату на щомісячні платежі по 10 000 євро.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Комісії та KYC</p><h2>Що може вплинути на виплату</h2></div>
    <p>Витрати на переказ коштів можуть бути утримані з виплати, а платіжний метод додатково може застосувати власну сервісну комісію. Для рахунків із низьким оборотом Pokerbet може передбачати окрему плату за обробку платежу.</p>
    <p>Для Pokerbet виведення важлива не тільки сума, а й підтвердження власника рахунку. При запиті на суму понад 1 000 євро або у разі додаткової ідентифікаційної перевірки оператор може запросити документ, підтвердження адреси та фото банківської картки.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Затримки</p><h2>Чому не приходить виплата Pokerbet</h2></div>
    <InfoTable caption="Проблеми з виведенням Pokerbet" headers={['Проблема', 'Можлива причина', 'Що робити']} rows={problemRows} />
    <p>Якщо статус операції незрозумілий, не потрібно створювати нову заявку на ту саму суму або намагатися "розблокувати" виплату новим депозитом. Краще перевірити історію транзакцій і звернутися до підтримки Pokerbet з номером операції, сумою та датою заявки.</p>
  </section>

  <FAQ items={faq} />
</BaseLayout>
