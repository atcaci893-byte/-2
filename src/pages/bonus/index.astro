---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DocImageGrid from '../../components/DocImageGrid.astro';
import InfoTable from '../../components/InfoTable.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { bonusData } from '../../data/bonuses';
import { faqSchema } from '../../lib/schema';

const faq = [
  { question: 'Який вітальний бонус Pokerbet діє у 2026 році?', answer: 'Станом на 28 серпня 2026 року новим гравцям казино доступний пакет на перші п’ять депозитів із загальною винагородою до 150 000 грн + 650 фріспінів.' },
  { question: 'Який мінімальний депозит для бонусу Pokerbet?', answer: 'Для отримання Welcome Pack потрібно внести від 500 грн. VIP-пропозиція має окремий поріг - від 10 000 грн.' },
  { question: 'Який вейджер у Pokerbet?', answer: 'Він залежить від бонусу. Для вітального пакета підтверджені x10, x15 та x35 залежно від конкретної винагороди й депозиту. Для VIP-бонусу - x30.' },
  { question: 'Скільки часу дається на відіграш?', answer: 'Грошову частину Welcome Pack потрібно відіграти за 48 годин. Фріспіни необхідно активувати та використати протягом 24 годин після отримання.' },
  { question: 'Чи потрібен промокод Pokerbet?', answer: 'Для вітального пакета - ні. Код потрібен для окремої VIP-пропозиції та може застосовуватися в реферальній програмі.' },
  { question: 'Чи можна одразу вивести бонус Pokerbet?', answer: 'Бонусні кошти мають умови wagering. Для Welcome Pack після відіграшу діє максимальний ліміт x3 від суми отриманого бонусу.' },
];
const activeBonuses = [
  ['Welcome-бонус за перші 5 депозитів', 'До 150 000 грн сумарно', 'До 650 FS', '500 грн', 'x15 для криптобонусів; x10 для 2-го депозиту; x35 для інших бонусів та FS', 'Нові гравці казино'],
  ['VIP-бонус на перший депозит', '200%, до 50 000 грн', '100 FS', '10 000 грн', 'x30', 'Нові гравці, які обирають VIP-пропозицію'],
  ['Welcome Missions', 'Призи сумарною вартістю до 2 000 грн', 'Є серед окремих нагород', 'Не прив’язані до одного депозиту', 'Залежить від типу призу', 'Нові гравці Pokerbet'],
];
const depositRows = [
  ['№1', 'від 500 грн - 150%', '30 000 грн', '100 FS по 2 грн', '100%', '10 000 грн'],
  ['№2', '75% / 100% / 125% залежно від суми', '1 000 / 3 000 / 30 000 грн', '150 FS по 2 / 4 / 6 грн', '75%', '8 000 грн'],
  ['№3', '50% / 75% / 100% залежно від суми', '1 000 / 3 000 / 30 000 грн', '150 FS по 2 / 4 / 6 грн', '50%', '5 000 грн'],
  ['№4', '25% / 50% / 75% залежно від суми', '1 000 / 3 000 / 30 000 грн', '150 FS по 2 / 4 / 6 грн', '50%', '5 000 грн'],
  ['№5', 'від 500 грн - 150%', '30 000 грн', '100 FS по 2 грн', '50%', '10 000 грн'],
];
const wageringRows = [
  ['Активація', 'Вибрати бонус перед депозитом'],
  ['Дозволені ігри', 'Ігри казино; для окремих ігор діє різний Game Contribution'],
  ['Вейджер', 'x10, x15 або x35 залежно від типу винагороди'],
  ['Строк для відіграшу', '48 годин'],
  ['Строк для фріспінів', '24 години після отримання'],
  ['Ліміт після відіграшу', 'Максимум x3 від суми бонусу'],
  ['Промокод', 'Для стандартного Welcome Pack не потрібен'],
];
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Бонуси', href: '/bonus/' }];
---

<BaseLayout title="Бонуси Pokerbet 2026 – вітальний бонус та фріспіни" description="Бонуси Pokerbet 2026: вітальна пропозиція, фріспіни, VIP-бонус та інші активні акції. Умови депозиту, активації, вейджеру, строків і виведення коштів." breadcrumbs={crumbs} schemas={[faqSchema(faq)]}>
  <Hero variant="bonus" eyebrow="Бонуси" title="Бонуси Pokerbet 2026: вітальний бонус, фріспіни та умови" description={`Основний бонус Pokerbet для нових гравців казино охоплює перші п'ять депозитів: ${bonusData.welcomeAmount} + ${bonusData.freeSpins}. Мінімальне поповнення для активації - ${bonusData.minimumDeposit}.`} secondaryLabel="Як працює промокод" secondaryHref="/promokod/" />

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Актуальні бонуси Pokerbet 2026</p><h2>Welcome Pack, VIP-бонус і місії</h2></div>
    <p>Вейджер залежить від депозиту та способу оплати: для грошових криптобонусів заявлено x15, для грошового бонусу за другий депозит - x10, для інших грошових бонусів і фріспінів - x35. На відіграш грошового бонусу дається 48 годин.</p>
    <DocImageGrid images={[
      { src: '/assets/docs/bonus/bonus-1.jpg', alt: 'Банер Pokerbet з бонусом до 150 000 грн і 650 фріспінів', caption: 'Вітальна пропозиція казино' },
      { src: '/assets/docs/bonus/bonus-3.jpg', alt: 'Промо-зображення Pokerbet Casino із золотими фішками', caption: 'Казино-бонуси Pokerbet' },
    ]} />
    <InfoTable caption="Актуальні бонуси Pokerbet" headers={['Бонус', 'Сума', 'Фріспіни', 'Мін. депозит', 'Вейджер', 'Для кого']} rows={activeBonuses} />
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Вітальний пакет</p><h2>Бонус за перші п’ять депозитів</h2></div>
    <p>Вітальний бонус Pokerbet розрахований на перші п’ять депозитів. Загальний максимум пакета становить до 150 000 грн і 650 фріспінів, але формат винагороди залежить від способу поповнення.</p>
    <InfoTable caption="Розподіл вітального бонусу Pokerbet" headers={['Депозит', 'Сума', 'Макс. бонус', 'Фріспіни', 'Криптовалюта', 'Макс. криптобонус']} rows={depositRows} />
    <p>Для другого, третього та четвертого депозитів розмір винагороди за поповнення звичайними методами залежить від внесеної суми. Для криптовалютних поповнень діє окрема сітка, а за умовами акції такі грошові криптобонуси мають вейджер x15.</p>
    <p>Гравець також може комбінувати способи оплати між поповненнями. Максимальна сума, яка може залишитися після відіграшу бонусної винагороди, обмежена x3 від початкової суми бонусу.</p>
    <DocImageGrid images={[
      { src: '/assets/docs/bonus/bonus-2.jpg', alt: 'Інтерфейс Pokerbet із каруселлю казино-бонусів', caption: 'Бонусний блок в інтерфейсі' },
      { src: '/assets/docs/bonus/bonus-4.jpg', alt: 'Каса Pokerbet з активними бонусними картками', caption: 'Бонуси перед депозитом' },
    ]} />
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Активація</p><h2>Як отримати бонус Pokerbet</h2></div>
    <ol class="steps">
      <li><strong>Пройти реєстрацію Pokerbet.</strong><p>Створіть акаунт і перевірте контактні дані.</p></li>
      <li><strong>Відкрити розділ "Подарунки та бонуси".</strong><p>Саме там потрібно вибрати пропозицію.</p></li>
      <li><strong>Активувати потрібний бонус.</strong><p>Зробіть це до поповнення балансу.</p></li>
      <li><strong>Внести від 500 грн.</strong><p>Після депозиту перевірте зарахування грошового бонусу або фріспінів.</p></li>
    </ol>
    <p class="notice"><strong>Важливо:</strong> якщо спочатку зробити депозит без активованої пропозиції, нарахування Welcome-бонусу може не відбутися.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Wagering</p><h2>Умови відіграшу бонусу Pokerbet</h2></div>
    <p>Вейджер Pokerbet показує, який обсяг гри потрібно зробити в казино, перш ніж бонус стане доступним для виведення. Наприклад, якщо грошовий бонус становить 1 000 грн і для нього встановлено x35, необхідний обсяг ставок становитиме 35 000 грн.</p>
    <InfoTable caption="Умови відіграшу Pokerbet" headers={['Умова', 'Інформація']} rows={wageringRows} />
    <p>Не всі ставки однаково впливають на прогрес відіграшу. Для частини ігор Pokerbet використовує Game Contribution - коефіцієнт, який визначає, яка частина ставки зараховується у відіграш.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Фріспіни</p><h2>Як працюють FS у Pokerbet</h2></div>
    <p>Фріспіни Pokerbet входять до стандартного пакета за перші п’ять депозитів. Загальний Welcome Pack передбачає до 650 FS. Після нарахування фріспіни потрібно окремо активувати в розділі "Подарунки та бонуси"; на їх використання та відіграш дається 24 години.</p>
    <ul>
      <li>перший депозит від 500 грн - 100 FS номіналом 2 грн;</li>
      <li>другий, третій і четвертий депозити - 150 FS залежно від суми поповнення;</li>
      <li>п’ятий депозит від 500 грн - 100 FS номіналом 2 грн.</li>
    </ul>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Інші акції</p><h2>VIP-бонус, місії та реферальна програма</h2></div>
    <div class="card-grid">
      <article class="info-card"><span class="number">VIP</span><h3>VIP-бонус</h3><p>Альтернативний Welcome-офер передбачає 200% до першого депозиту, максимум 50 000 грн, 100 фріспінів та два фрібети. Мінімальний депозит - 10 000 грн, вейджер - x30.</p></article>
      <article class="info-card"><span class="number">30</span><h3>Welcome Missions</h3><p>Новим користувачам протягом 30 днів після реєстрації доступні місії з винагородами: гейм-бонуси, турнірні квитки, Tournament Money, фріспіни та кеш.</p></article>
      <article class="info-card"><span class="number">REF</span><h3>Бонус за друга</h3><p>Верифікований гравець може запросити нового користувача за реферальним посиланням або кодом. Для FS діє вейджер x25, а максимальна сума виграшу - 1 200 грн.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Проблеми</p><h2>Чому бонус Pokerbet не нарахували</h2></div>
    <ul>
      <li>бонус не був вибраний до депозиту;</li>
      <li>сума поповнення нижча за встановлений мінімум;</li>
      <li>пропозиція призначена лише для нових користувачів;</li>
      <li>депозит уже не входить до перших п’яти поповнень;</li>
      <li>минув строк активації або використання винагороди;</li>
      <li>для окремої акції неправильно введено необхідний код.</li>
    </ul>
    <p>Якщо всі вимоги виконані, а винагороди немає, можна звернутися до служби підтримки Pokerbet.</p>
  </section>

  <FAQ items={faq} title="Поширені запитання про бонуси Pokerbet" />
  <CTA title="Є код для активації?" text="Промокоди мають окрему логіку та не змішуються з повним оглядом бонусних умов." label="Відкрити гід про промокоди" href="/promokod/" quiet />
</BaseLayout>
