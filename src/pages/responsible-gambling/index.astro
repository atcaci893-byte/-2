---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Відповідальна гра', href: '/responsible-gambling/' }];
---
<BaseLayout title="Відповідальна гра — контроль бюджету та самообмеження" description="Інформація 21+ про відповідальну гру: бюджет, ліміти, паузи, самообмеження, ознаки проблемної поведінки та пошук допомоги в Україні." breadcrumbs={crumbs} hideHeaderCta>
  <Hero variant="quiet" eyebrow="Відповідальна гра · 21+" title="Гра не повинна шкодити бюджету чи життю" description="Ця сторінка не містить закликів до гри. Її мета — допомогти вчасно встановити межі, зробити паузу або звернутися по підтримку." note="Якщо ви намагаєтеся відіграти програш, приховуєте витрати або позичаєте кошти для гри — зупиніться та зверніться по допомогу." />
  <section class="section"><div class="card-grid"><article class="info-card"><span class="number">LIMIT</span><h3>Ліміти</h3><p>Встановіть граничну суму та час заздалегідь. Не змінюйте межі під впливом емоцій.</p></article><article class="info-card"><span class="number">PAUSE</span><h3>Пауза й самообмеження</h3><p>Скористайтеся доступними інструментами перерви або самообмеження. Уточніть їх у підтримки.</p></article><article class="info-card"><span class="number">HELP</span><h3>Допомога</h3><p>Зверніться до близької людини, фахівця з психічного здоров’я або профільної служби підтримки.</p></article></div></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">Сигнали ризику</p><h2>Коли варто зупинитися</h2></div><ul class="steps"><li><strong>Втрата контролю часу</strong><p>Гра регулярно триває довше, ніж ви планували.</p></li><li><strong>Спроба відігратися</strong><p>Після програшу ви збільшуєте ставки або повертаєтеся всупереч плану.</p></li><li><strong>Фінансовий тиск</strong><p>На гру йдуть кошти, потрібні для базових витрат, або позичені гроші.</p></li><li><strong>Приховування</strong><p>Ви приховуєте час або суми від близьких і відчуваєте провину.</p></li></ul></section>
  <p class="notice"><strong>Юридична інформація для України:</strong> точні посилання на чинні норми та профільні служби мають бути додані редактором після окремої юридичної перевірки.</p>
</BaseLayout>
