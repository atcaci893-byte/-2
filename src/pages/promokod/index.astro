---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import FAQ from '../../components/FAQ.astro';
import { faqSchema } from '../../lib/schema';
const faq = [
  { question: 'Коли зазвичай вводять промокод?', answer: 'Залежно від механіки пропозиції — під час реєстрації, перед депозитом або в окремому полі профілю. Точний момент потрібно перевірити в правилах.' },
  { question: 'Що може активувати код?', answer: 'Код може бути пов’язаний із бонусом, фриспінами чи іншою акцією, але конкретний результат визначають лише актуальні правила.' },
  { question: 'Чому код не працює?', answer: 'Перевірте регістр символів, строк дії, вимоги до акаунта, мінімальний депозит і те, чи не був код використаний раніше.' },
];
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Промокод', href: '/promokod/' }];
---
<BaseLayout title="Pokerbet промокод — де й коли вводити код" description="Інструкція щодо промокоду Pokerbet: де знайти поле, коли вводити, що перевірити та чому код може не працювати." breadcrumbs={crumbs} schemas={[faqSchema(faq)]}>
  <Hero eyebrow="Промокод" title="Код спрацює лише за правильних умов" description="Окремий гід про момент введення, перевірку символів і типові причини помилки — без підміни сторінки повним описом бонусів." secondaryLabel="Дивитися бонусні умови" secondaryHref="/bonus/" />
  <aside class="promo-code-panel"><span>Промокод Pokerbet</span><strong>Код не підтверджено</strong><p>Де знайти та як активувати промокод — пояснюємо нижче без вигаданих символів.</p></aside>
  <section class="section"><div class="section-heading"><p class="eyebrow">Інструкція</p><h2>Як використати промокод</h2></div><ol class="steps"><li><strong>Відкрийте форму</strong><p>Перейдіть до реєстрації або розділу акцій — залежно від зазначеної механіки.</p></li><li><strong>Знайдіть поле промокоду</strong><p>Не завершуйте дію, доки не перевірите, чи код потрібно вводити саме на цьому етапі.</p></li><li><strong>Введіть код без змін</strong><p>Скопіюйте символи без пробілів і перевірте регістр.</p></li><li><strong>Перевірте результат</strong><p>Переконайтеся, що потрібна пропозиція відобразилася до внесення коштів.</p></li></ol></section>
  <FAQ items={faq} />
</BaseLayout>
