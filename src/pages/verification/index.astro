---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InfoTable from '../../components/InfoTable.astro';
import FAQ from '../../components/FAQ.astro';
import { faqSchema } from '../../lib/schema';

const faq = [
  { question: 'Чи обов’язкова Pokerbet верифікація після реєстрації?', answer: 'Не обов’язково проходити повний Pokerbet KYC відразу після створення акаунту. Реєстрація, підтвердження контактів і документальна перевірка - різні етапи. Документи можуть бути запитані пізніше залежно від операції або результатів перевірки.' },
  { question: 'Скільки триває верифікація Pokerbet?', answer: 'Фіксований універсальний строк не встановлений. Pokerbet зазначає, що тривалість перевірки залежить від конкретного профілю гравця та обсягу необхідної перевірки.' },
  { question: 'Які документи Pokerbet приймає для KYC?', answer: 'Для підтвердження особи Pokerbet можуть використовуватися паспорт або ID-картка. Додатково оператор може запросити документ на адресу, підтвердження платіжної картки, селфі з документом або інші матеріали.' },
  { question: 'Чи можна пройти KYC Pokerbet з телефону?', answer: 'Так, якщо інтерфейс акаунту дозволяє завантажити документи зі смартфона. Важливо використовувати читабельні фотографії та завантажувати їх через передбачений Pokerbet канал.' },
  { question: 'Що робити, якщо Pokerbet не приймає документи?', answer: 'Перевірте повідомлення про причину відмови, відповідність даних у профілі та тип документа. Якщо причина не зрозуміла, зверніться до підтримки Pokerbet і уточніть, що саме потрібно виправити.' },
  { question: 'Чи потрібна Pokerbet верифікація перед виведенням коштів?', answer: 'Так, KYC може бути необхідною умовою для виведення. Pokerbet прямо передбачає перевірку особи та платіжної інформації в рамках процедури withdrawal.' },
  { question: 'Чи може Pokerbet попросити підтвердити адресу?', answer: 'Так. Під час додаткової перевірки оператор може запросити документ, що підтверджує адресу проживання. У правилах окремо зазначено, що для цієї мети не використовується рахунок за мобільний телефон.' },
  { question: 'Що робити якщо верифікація Покербет затягнулася?', answer: 'Перевірте статус перевірки, повідомлення в акаунті та електронну пошту. Якщо всі матеріали вже подані, а інформації про подальші дії немає, зверніться до підтримки.' },
];
const summaryRows = [
  ['Коли може знадобитися KYC', 'Під час роботи з акаунтом, депозитів, виведення або додаткової перевірки'],
  ['Де проходить', 'Через процедуру перевірки акаунту Pokerbet'],
  ['Основні документи', 'Паспорт або ID-картка'],
  ['Додаткові документи', 'Підтвердження адреси, платіжна картка, селфі, відео-верифікація'],
  ['Мова документів', 'Кирилиця або латиниця'],
  ['Фіксований строк', 'Не встановлений: термін залежить від конкретного акаунту'],
];
const docsRows = [
  ['Паспорт', 'Особу та основні персональні дані', 'Первинна або додаткова ідентифікація'],
  ['ID-картка', 'Особу та дату народження', 'Замість паспорта'],
  ['Документ на адресу', 'Місце проживання', 'Додаткова перевірка'],
  ['Банківська картка', 'Власника платіжного інструмента', 'Підтвердження способу депозиту/виведення'],
  ['Селфі з документом', 'Відповідність документа користувачу', 'Якщо цього вимагає Pokerbet перевірка документів'],
  ['Відео-верифікація', 'Додаткове підтвердження особи Pokerbet', 'При підозрі на шахрайство або інших контрольних процедурах'],
  ['Банківська виписка / фінансовий документ', 'Платіжні дані або походження коштів', 'Під час AML-перевірки'],
];
const rejectRows = [
  ['Документ відхилено', 'Повідомлення про причину', 'Завантажити документ повторно відповідно до запиту'],
  ['Дані не збігаються', 'Ім’я, прізвище, дата народження, адреса', 'Звірити інформацію в акаунті та документі'],
  ['Потрібен інший документ', 'Новий запит Pokerbet', 'Надати саме зазначений тип документа'],
  ['Потрібне підтвердження картки', 'Дані власника та видимі реквізити', 'Підготувати фото відповідно до правил'],
  ['З’явився додатковий KYC-запит', 'Повідомлення або email', 'Відповісти на запит і надати необхідні матеріали'],
  ['Статус довго не змінюється', 'Час подання та останнє повідомлення', 'Не дублювати файли без потреби та звернутися до підтримки'],
];
const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Верифікація', href: '/verification/' }];
---

<BaseLayout title="Верифікація Pokerbet 2026: KYC, документи та строки" description="Верифікація Pokerbet: коли можуть запросити KYC, які документи потрібні, як пройти перевірку та що робити, якщо документи відхилили або перевірка затягнулася." breadcrumbs={crumbs} schemas={[faqSchema(faq)]}>
  <Hero eyebrow="KYC" title="Верифікація Pokerbet 2026: KYC, документи та як пройти перевірку" description="Pokerbet верифікація не зводиться до одного обов’язкового кроку одразу після реєстрації. Документи можуть запросити під час депозиту, виведення коштів або окремої перевірки аккаунту." />

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Основна інформація</p><h2>Верифікація Pokerbet 2026</h2></div>
    <p>Pokerbet розділяє звичайне створення акаунту та повноцінну перевірку особи. Під час реєстрації користувач надає персональні й контактні дані, а оператор залишає за собою право додатково підтвердити їх у процесі обслуговування рахунку.</p>
    <InfoTable caption="Основна інформація про KYC Pokerbet" headers={['Параметр', 'Що підтверджено']} rows={summaryRows} />
    <p>У правилах Pokerbet не вказано один універсальний строк перевірки для всіх клієнтів. Час верифікації визначається індивідуально для кожного ігрового рахунку.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Коли потрібна</p><h2>Коли платформа просить пройти верифікацію Pokerbet</h2></div>
    <p>Найчастіше користувач стикається з вимогами KYC не через сам факт створення акаунту, а коли оператору потрібно підтвердити дані, платіж або операцію.</p>
    <div class="card-grid kyc-grid">
      <article class="info-card"><span class="number">01</span><h3>Перевірка особи</h3><p>Pokerbet має право запросити документи для підтвердження того, що акаунт належить саме зазначеній людині.</p></article>
      <article class="info-card"><span class="number">02</span><h3>Фінансова операція</h3><p>Додаткові процедури ідентифікації можуть проводитися при внесенні коштів або перевірці платіжного інструмента.</p></article>
      <article class="info-card"><span class="number">03</span><h3>Виведення коштів</h3><p>Withdrawals можуть вимагати підтвердження особи, анкети та додаткової інформації, якщо метод виведення відрізняється від депозитного.</p></article>
      <article class="info-card"><span class="number">AML</span><h3>AML-сценарії</h3><p>Для операцій від 2 200 євро або при підозрілій активності можуть застосовуватися додаткові заходи перевірки.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Документи</p><h2>Які документи для верифікації Pokerbet необхідні</h2></div>
    <p>Pokerbet у правилах і AML/KYC-політиці підтверджує кілька категорій документів. Водночас вони не потрібні всім користувачам одночасно.</p>
    <InfoTable caption="Документи для верифікації Pokerbet" headers={['Документ', 'Що підтверджує', 'Коли може знадобитися']} rows={docsRows} />
    <p>При запиті на суму понад 1 000 EUR або під час додаткової ідентифікації Pokerbet може попросити фото документа, що посвідчує особу, документ на адресу та фото банківської картки, якщо вона використовувалася для депозиту.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Додаткові запити</p><h2>Що ще може запросити Pokerbet</h2></div>
    <p>Для посиленої перевірки Pokerbet залишає за собою право запросити додаткові особисті або фінансові документи: водійське посвідчення, рахунки за комунальні послуги, банківські виписки та інші матеріали.</p>
    <p>При ознаках шахрайських дій може бути призначена відео-верифікація. Дата дзвінка погоджується з користувачем, мову повідомляють заздалегідь, а під час перевірки потрібно продемонструвати документи та відповісти на запитання співробітника.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Процес</p><h2>Як пройти верифікацію Pokerbet</h2></div>
    <ol class="steps">
      <li><strong>Увійти до акаунту.</strong><p>Відкрийте повідомлення або розділ, де Pokerbet запросив підтвердження.</p></li>
      <li><strong>Перевірити, який документ потрібен.</strong><p>Не завантажуйте весь набір можливих документів без запиту.</p></li>
      <li><strong>Підготувати чітке фото або цифрову копію.</strong><p>Текст, фотографія та основні реквізити повинні нормально проглядатися.</p></li>
      <li><strong>Завантажити через передбачений інтерфейс.</strong><p>За потреби додайте документ на адресу або підтвердження платіжного методу.</p></li>
      <li><strong>Дочекатися результату.</strong><p>Якщо система запросила додаткову інформацію, надайте її в межах зазначеного строку.</p></li>
    </ol>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Виплати</p><h2>Верифікація Pokerbet перед зняттям коштів</h2></div>
    <p>KYC на Pokerbet має прямий зв’язок із виплатами. У правилах платформи вказується, що виведення коштів можливе після повної верифікації облікового запису та проходження KYC. Додаткова перевірка передбачена для виплат понад 1 000 EUR, але оператор залишає за собою право перевіряти й менші суми.</p>
    <p>Якщо спосіб виведення відрізняється від способу поповнення, Pokerbet може запросити додаткову інформацію про платіж і матеріали для перевірки законного походження коштів.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Безпека</p><h2>Безпека документів під час Pokerbet KYC</h2></div>
    <p>Документи потрібно передавати лише через передбачений Pokerbet канал верифікації. Не надсилайте паспорт, фото картки чи селфі випадковому менеджеру в Telegram, соціальних мережах або приватному чаті.</p>
    <p>Окрему увагу приділіть фото картки. У випадку, описаному в правилах, Pokerbet не вимагає показувати всі 16 цифр - достатньо тих частин номера, які прямо зазначені в умовах.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Затримка</p><h2>Що робити коли Покербет верифікація затягнулася</h2></div>
    <p>Спочатку перевірте статус заявки та повідомлення в акаунті. Потім перегляньте email, прив’язаний до профілю: оператор може надіслати туди запит на додаткову інформацію.</p>
    <p>Якщо всі документи вже відправлені, а нового повідомлення немає, не варто завантажувати одні й ті самі файли багато разів. Краще звернутися до підтримки Pokerbet, вказавши логін, дату подання документів і статус перевірки.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Відмова</p><h2>Чому не пройшла перевірка документів Pokerbet</h2></div>
    <p>Якщо документ відхилено, спочатку потрібно подивитися повідомлення в акаунті або лист від Pokerbet. Сам факт відмови ще не означає, що проблема саме в документі: оператор міг запросити інший тип підтвердження або додаткову інформацію.</p>
    <InfoTable caption="Причини відхилення документів Pokerbet" headers={['Проблема', 'Що перевірити', 'Що робити']} rows={rejectRows} />
    <p>Не варто самостійно змінювати фотографії документів, редагувати дані або закривати частину інформації, яку Pokerbet прямо просить показати. Це може лише ускладнити перевірку.</p>
  </section>

  <section class="section">
    <div class="section-heading"><p class="eyebrow">Висновок</p><h2>Що важливо пам’ятати</h2></div>
    <p>Верифікація Покербет не завжди починається одразу після реєстрації. Спочатку користувач створює акаунт і підтверджує контактні дані, а повноцінний KYC може з’явитися пізніше - зокрема під час фінансових операцій або додаткової перевірки.</p>
    <p>Фіксованого строку проходження KYC для всіх акаунтів немає. Якщо перевірка триває довше очікуваного або документ відхилено, спочатку потрібно перевірити повідомлення в акаунті й лише потім звертатися до підтримки.</p>
  </section>

  <FAQ items={faq} />
</BaseLayout>
