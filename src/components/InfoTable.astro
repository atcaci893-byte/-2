---
interface Props { headers: string[]; rows: (string | number)[][]; caption: string }
const { headers, rows, caption } = Astro.props;
---

<div class="table-wrap" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption>{caption}</caption>
    <thead><tr>{headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
    <tbody>{rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
  </table>
</div>

