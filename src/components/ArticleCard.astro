---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  updatedAt: Date;
  imageAlt: string;
  image: string;
  featured?: boolean;
}
const { slug, title, description, category, publishedAt, updatedAt, imageAlt, image, featured = false } = Astro.props;
const format = (date: Date) => new Intl.DateTimeFormat('uk-UA', { day: '2-digit', month: 'long', year: 'numeric' }).format(date);
---

<article class:list={['article-card', { featured }]}>
  <a class="article-visual" href={`/news/${slug}/`} aria-label={`${title}. ${imageAlt}`}>
    <img src={image} alt={imageAlt} width="900" height="600" loading="lazy" decoding="async" />
    <span>{category}</span>
  </a>
  <div class="article-card-body">
    <p class="article-meta"><span>{category}</span> · {format(publishedAt)}</p>
    <h2><a href={`/news/${slug}/`}>{title}</a></h2>
    <p>{description}</p>
    <div class="article-card-footer"><small>Оновлено {format(updatedAt)}</small><a class="text-link" href={`/news/${slug}/`}>Читати <span aria-hidden="true">→</span></a></div>
  </div>
</article>
